# These values are documentation only. Spring Boot does not load this file automatically.
DB_URL=jdbc:mysql://localhost:3306/placement_management_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_mysql_password
APP_JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# Optional: used only on first startup when the database has no ADMIN account.
INITIAL_ADMIN_EMAIL=your-admin-email@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_temporary_password
